# POLYNOMIAL REGRESSION AND BIAS-VARIANCE TRADE-OFF

# Step 1: Import Libraries
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler, PolynomialFeatures
from sklearn.linear_model import LinearRegression
from sklearn.pipeline import make_pipeline
from sklearn.metrics import mean_squared_error


# Step 2: Load Dataset
url = "https://raw.githubusercontent.com/selva86/datasets/master/Auto.csv"
df = pd.read_csv(url)

print("First Five Records:")
print(df.head())


# Step 3: Check Missing Values
print("\nMissing Values:")
print(df.isnull().sum())


# Step 4: Select Input Feature
X = df[['horsepower']]

# Step 5: Select Target Variable
y = df['mpg']


# Step 6: Split Dataset
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.30, random_state=42
)

print("\nTraining Data:", X_train.shape)
print("Testing Data:", X_test.shape)


# Step 7: Create Polynomial Regression Model
def poly_model(degree):
    return make_pipeline(
        StandardScaler(),
        PolynomialFeatures(degree),
        LinearRegression()
    )


# Step 8: Examine Polynomial Features
print("\nPolynomial Features:")
print(PolynomialFeatures(3).fit_transform([[3.0]]))


# Step 9: Train Models from Degree 1 to 15
degrees = range(1, 16)

models = [
    poly_model(d).fit(X_train, y_train)
    for d in degrees
]


# Step 10: Calculate Training and Testing RMSE
train_rmse = [
    np.sqrt(mean_squared_error(y_train, m.predict(X_train)))
    for m in models
]

test_rmse = [
    np.sqrt(mean_squared_error(y_test, m.predict(X_test)))
    for m in models
]


# Step 11: Display Results Table
results = pd.DataFrame({
    'Degree': degrees,
    'Train RMSE': train_rmse,
    'Test RMSE': test_rmse
})

print("\nPolynomial Regression Results:")
print(results.round(3))


# Step 12: Identify Best Degree
best = results.loc[
    results['Test RMSE'].idxmin(), 'Degree'
]

print("\nBest Degree:", best)

print("Minimum Training RMSE:",
      min(train_rmse))

print("Minimum Testing RMSE:",
      min(test_rmse))

print("Test RMSE at Degree 15:",
      test_rmse[-1])


# Step 13: Plot Model Complexity vs Error
plt.figure(figsize=(8, 5))

plt.plot(degrees, train_rmse, 'o-', label="Train RMSE")
plt.plot(degrees, test_rmse, 's-', label="Test RMSE")

plt.xlabel("Polynomial Degree")
plt.ylabel("RMSE")
plt.title("Model Complexity vs Error")

plt.legend()
plt.grid(alpha=0.3)
plt.show()


# Step 14: Plot Fitted Polynomial Curves
grid = np.linspace(
    X.min().iloc[0],
    X.max().iloc[0],
    300
).reshape(-1, 1)

plt.figure(figsize=(8, 5))

plt.scatter(X, y, s=12, color="lightgray", label="Data")

for d in [1, 2, 15]:
    model = poly_model(d).fit(X_train, y_train)

    plt.plot(
        grid,
        model.predict(grid),
        linewidth=2,
        label=f"Degree {d}"
    )

plt.xlabel("Horsepower")
plt.ylabel("MPG")
plt.ylim(5, 50)

plt.title("Fitted Polynomial Curves")
plt.legend()
plt.show()


# Step 15: Examine Coefficients
final_model = poly_model(2).fit(X_train, y_train)

lr = final_model.named_steps['linearregression']

print("\nCoefficients:")
print(lr.coef_)

print("\nIntercept:")
print(lr.intercept_)


# Final Result
print("\nPRACTICAL COMPLETED SUCCESSFULLY!")
