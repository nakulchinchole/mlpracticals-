# MULTIPLE LINEAR REGRESSION - AUTO MPG DATASET

# Step 1: Import Required Libraries
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_squared_error, r2_score

# Step 2: Load Dataset
url = "https://raw.githubusercontent.com/selva86/datasets/master/Auto.csv"
df = pd.read_csv(url)

print("Dataset:")
print(df.head())

# Step 3: Check Missing Values
print("\nMissing Values:")
print(df.isnull().sum())

# Step 4: Select Input Features
X = df[['cylinders', 'displacement', 'horsepower',
        'weight', 'acceleration', 'year']]

# Step 5: Select Target Variable
y = df['mpg']

# Step 6: Split Dataset
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.20, random_state=42
)

print("\nTraining and Testing Data:")
print("X_train:", X_train.shape)
print("X_test:", X_test.shape)
print("y_train:", y_train.shape)
print("y_test:", y_test.shape)

# Step 7: Create Multiple Linear Regression Model
model = LinearRegression()

# Step 8: Train Model
model.fit(X_train, y_train)

# Step 9: Predict MPG
y_pred = model.predict(X_test)

print("\nPredicted MPG:")
print(y_pred[:10])

# Step 10: Compare Actual and Predicted Values
comparison = pd.DataFrame({
    'Actual MPG': y_test.values,
    'Predicted MPG': y_pred
})

print("\nActual vs Predicted:")
print(comparison.head(10))

# Step 11: Calculate MSE
mse = mean_squared_error(y_test, y_pred)

# Step 12: Calculate RMSE
rmse = np.sqrt(mse)

# Step 13: Calculate R2 Score
r2 = r2_score(y_test, y_pred)

# Step 14: Display Model Performance
print("\nModel Performance")
print("------------------")
print("MSE :", mse)
print("RMSE:", rmse)
print("R2  :", r2)

# Step 15: Examine Regression Coefficients
coefficients = pd.DataFrame({
    'Feature': X.columns,
    'Coefficient': model.coef_
})

print("\nRegression Coefficients:")
print(coefficients)

print("\nIntercept:", model.intercept_)

# Step 16: Actual vs Predicted Graph
plt.figure(figsize=(8, 6))
plt.scatter(y_test, y_pred)
plt.xlabel("Actual MPG")
plt.ylabel("Predicted MPG")
plt.title("Actual vs Predicted MPG")
plt.show()
